# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="dev"
DEBUG="true"

# Server settings:
SERVER_HOST="0.0.0.0"
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60

# K8S settings:
K8S_CONFIG="apiVersion: v1
            clusters:
            - cluster:
                certificate-authority-data: key
                server: https://localhost:56846
              name: k8s
            contexts:
            - context:
                cluster: k8s
                user: k8s
              name: k8s
            current-context: k8s
            kind: Config
            preferences: {}
            users:
            - name: k8s
              user:
                client-certificate-data: key
                client-key-data: key"
K8S_NAMESPACE="k8s-users"

# Git settings
GITLAB_BASE_URL="https://gitlab.com"
GITLAB_REPO_ID="67531592"
GITLAB_ACCESS_KEY=""
GITLAB_BRANCH="main"
