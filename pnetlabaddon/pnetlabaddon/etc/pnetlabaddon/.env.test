# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="prod"
DEBUG="false"

# Server settings:
SERVER_HOST="127.0.0.1"
SERVER_PORT=5885
SERVER_READ_TIMEOUT=60

# Database settings:
DB_TYPE="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="pnetlab"
DB_PASSWORD="pnetlab"
DB_NAME="pnetlab_db"
DB_SSL_MODE="disable"
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_CONNECTIONS=30
DB_TABLE_PREFIX="addon_"

# CMS client
CMS_MAX_TIMEOUT=30  # in seconds
CMS_CLIENT_ID=client-id
CMS_TOKEN=pnetlab
CMS_BASE_URL=http://localhost:5000

# Guacamole client
GUACAMOLE_MAX_TIMEOUT=30  # in seconds
GUACAMOLE_BASE_URL=http://127.0.0.1
