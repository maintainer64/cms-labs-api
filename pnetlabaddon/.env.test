# Stage status to start server:
#   - "dev", for start server without graceful shutdown
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="prod"
DEBUG="false"

# Server settings:
SERVER_HOST="0.0.0.0"
SERVER_PORT=5000
SERVER_READ_TIMEOUT=60

# Database settings:
DB_TYPE="mysql"
DB_HOST="mysqldatabase"
DB_PORT=3306
DB_USER="user"
DB_PASSWORD="pnetlab"
DB_NAME="db"
DB_SSL_MODE="disable"
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_CONNECTIONS=30
DB_TABLE_PREFIX="t_"

# CMS client
CMS_MAX_TIMEOUT=30  # in seconds
CMS_CLIENT_ID=client-id
CMS_USERNAME=pnetlab
CMS_PASSWORD=pnetlab
CMS_BASE_URL=http://localhost:5000
